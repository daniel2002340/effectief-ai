# Kopieer naar .env voor lokale ontwikkeling. Waarden hieronder passen bij docker-compose.yml
# en zijn geen echte secrets. Elke variabele is verplicht; apps starten niet als er een ontbreekt.

# Gedeeld
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://effectief:effectief@localhost:5442/effectief
REDIS_URL=redis://localhost:6389

# api
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5180

# web (wordt bij de build ingelezen)
VITE_API_URL=http://localhost:3000
