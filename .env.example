# Kopieer naar .env voor lokale ontwikkeling. Waarden hieronder passen bij docker-compose.yml
# en zijn geen echte secrets. Elke variabele is verplicht; apps starten niet als er een ontbreekt.

# Gedeeld
NODE_ENV=development
LOG_LEVEL=info
# Eigenaar: alleen voor migraties (#026). Daarna `pnpm db:roles` voor de login-rollen hieronder.
DATABASE_MIGRATION_URL=postgres://effectief:effectief@localhost:5442/effectief
# App-rol zonder BYPASSRLS voor api, worker en tests; auth-rol alleen voor Better Auth (#031)
DATABASE_URL=postgres://effectief_app:effectief_app@localhost:5442/effectief
DATABASE_AUTH_URL=postgres://effectief_auth:effectief_auth@localhost:5442/effectief
REDIS_URL=redis://localhost:6389

# api
API_HOST=127.0.0.1
API_PORT=3000
# false (geen proxy), een aantal proxy-hops, of een lijst proxy-IP's/CIDR's. Nooit true.
API_TRUST_PROXY=false
# Publieke origin van web + api (zelfde origin, #021); in dev de Vite-server
APP_ORIGIN=http://localhost:5180
# Ondertekent sessiecookies. Alleen voor lokaal; in productie `openssl rand -base64 32`.
BETTER_AUTH_SECRET=local-development-only-not-a-real-secret
# Wie mag een account maken: e-mailadressen en/of @domein, komma-gescheiden, of * voor iedereen (#062)
AUTH_SIGNUP_ALLOWLIST=*

# web: de api draait op dezelfde origin onder /api (in dev via de Vite-proxy)
VITE_API_BASE_PATH=/api
WEB_DEV_API_TARGET=http://localhost:3000
