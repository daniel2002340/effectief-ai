{
  "name": "@effectief/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./deploy": "./src/deploy/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:verify": "vitest run --config vitest.verify.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:roles": "node scripts/create-login-roles.ts"
  },
  "devDependencies": {
    "@effectief/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@effectief/ai": "workspace:*",
    "@effectief/shared": "workspace:*",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "zod": "catalog:"
  }
}
