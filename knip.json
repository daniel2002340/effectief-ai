{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/deploy/*.ts"]
    },
    "apps/*": {},
    "apps/web": {
      "entry": ["src/routes/**/*.tsx"]
    },
    "packages/*": {},
    "apps/worker": {
      "entry": ["scripts/*.ts"]
    },
    "packages/db": {
      "entry": ["scripts/*.ts"]
    }
  },
  "ignoreBinaries": ["cloudflared"],
  "ignoreIssues": {
    "apps/web/src/components/ui/**": ["exports", "types"]
  }
}
